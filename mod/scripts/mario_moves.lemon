//-------------------------------------------------------//
// Mario: state, moveset and physics                     //
//-------------------------------------------------------//

// Mario uses Sonic as his base character, i.e. he plays Sonic's route,
// and the Sonic object gets a Super Mario 64 moveset adapted to 2D:
//  - Jump, then jump again right after landing:  Double Jump, then Triple Jump
//  - Down (crouch) + Jump:                         Backflip
//  - Down while running (crouch slide) + Jump:     Long Jump
//  - Jump in mid-air:                              Dive (land into a belly slide)
//  - Jump while touching a wall in mid-air:        Wall Kick
//  - Down in mid-air:                              Ground Pound


// Character selection value used in Data Select save slots for Mario
constant u16 CHARS_MARIO = 5

// Mario's moves
constant u8 MARIO_MOVE_NONE        = 0
constant u8 MARIO_MOVE_JUMP1       = 1
constant u8 MARIO_MOVE_JUMP2       = 2
constant u8 MARIO_MOVE_JUMP3       = 3
constant u8 MARIO_MOVE_BACKFLIP    = 4
constant u8 MARIO_MOVE_LONGJUMP    = 5
constant u8 MARIO_MOVE_GP_SPIN     = 6
constant u8 MARIO_MOVE_GP_FALL     = 7
constant u8 MARIO_MOVE_GP_LAND     = 8
constant u8 MARIO_MOVE_DIVE        = 9
constant u8 MARIO_MOVE_DIVESLIDE   = 10
constant u8 MARIO_MOVE_WALLKICK    = 11
constant u8 MARIO_MOVE_CROUCHSLIDE = 12
constant u8 MARIO_MOVE_ROLLOUT     = 13

constant u8 MARIO_CHAIN_WINDOW     = 10		// Frames after landing in which the next jump of the chain can be done
constant u8 MARIO_WALL_WINDOW      = 7		// Frames after touching a wall in which a wall kick is possible
constant u8 MARIO_GP_SPIN_TIME     = 14


// Mod settings (see mod.json)
global u8 mario.option.everywhere		// 1 = Sonic alone gets replaced by Mario in all game modes (Act Select, Time Attack...)
global u8 mario.option.voice			// 1 = Mario voice clips enabled

// Runtime state
global u8 mario.active
global u8 mario.move
global u8 mario.timer
global u8 mario.jumpchain
global u8 mario.landtimer
global u8 mario.walltimer
global s8 mario.wallside
global s16 mario.prev_vx
global u8 mario.was_in_air
global u8 mario.dive_used
global u8 mario.gp_used
global u16 mario.anim_acc
global u8 mario.anim_frame
global u8 mario.anim_group
global u16 mario.idle_timer



function bool Mario.isControlled()
{
	return (mario.active != 0 && A0 == 0xffffb000 && char.character == CHARACTER_SONIC)
}


function void Mario.resetState()
{
	mario.move = MARIO_MOVE_NONE
	mario.timer = 0
	mario.jumpchain = 0
	mario.landtimer = 0
	mario.walltimer = 0
	mario.wallside = 0
	mario.prev_vx = 0
	mario.was_in_air = 0
	mario.dive_used = 0
	mario.gp_used = 0
	mario.anim_acc = 0
	mario.anim_frame = 0
	mario.anim_group = 0
	mario.idle_timer = 0
}


function void Mario.playVoice(string key)
{
	if (mario.option.voice)
	{
		Audio.playAudio(key, AudioContext.CONTEXT_SOUND)
	}
}


function s16 Mario.facingSign()
{
	return (char.flags & char.flag.FACING_LEFT) ? -1 : 1
}


// Scale a velocity value down when underwater
function s16 Mario.waterScale(s16 value)
{
	if (char.flags & char.flag.UNDERWATER)
		return value * 9 / 16
	return value
}


// Make sure the character is in the rolling state while in mid-air (that's what lets him attack enemies)
function void Mario.setRollingInAir()
{
	if ((char.flags & char.flag.ROLLING) == 0)
	{
		char.flags |= char.flag.ROLLING
		char.hitbox_extends.x = char.hitbox.x.ROLLING
		char.hitbox_extends.y = char.hitbox.y.ROLLING
		s8 dy = s8(char.hitbox_extends.y) - s8(char.hitbox.default.y)
		char.position.y.u16 += global.inv_gravity ? dy : -dy
	}
	char.state = char.state.ROLLING
}


// Add some extra jump velocity along the ground normal (same direction as the regular jump)
function void Mario.addJumpVelocity(s16 extra)
{
	u8 angle = char.rotation - 0x40
	char.velocity.x += (s32(lookupCos(angle)) * extra) >> 8
	char.velocity.y += (s32(lookupSin(angle)) * extra) >> 8
}


function void Mario.setMove(u8 move)
{
	mario.move = move
	mario.timer = 0
}



//-------------------------------------------------------//
// Character selection                                   //
//-------------------------------------------------------//

function void SetGlobalCharacters()
{
	u16 selection = levelselect.characters
	bool wantMario = (selection == CHARS_MARIO)
	if (mario.option.everywhere && selection == CHARS_SONIC_ALONE)
		wantMario = true

	// Base implementation does not know about Mario, so let it set up Sonic alone
	if (selection == CHARS_MARIO)
		levelselect.characters = CHARS_SONIC_ALONE

	base.SetGlobalCharacters()

	levelselect.characters = selection

	bool active = wantMario && (global.characters == CHARS_SONIC_ALONE) && (competition_mode.active == 0)
	if (active && mario.active == 0)
	{
		Mario.resetState()
	}
	mario.active = active ? 1 : 0
}



//-------------------------------------------------------//
// Ground moves                                          //
//-------------------------------------------------------//

// No Spindash for Mario, crouch + jump is the backflip instead
function bool Character.UpdateSpindash()
{
	if (Mario.isControlled())
		return false
	return base.Character.UpdateSpindash()
}

// No Super Peel-Out either
function bool Character.updateSuperPeelout()
{
	if (Mario.isControlled())
		return false
	return base.Character.updateSuperPeelout()
}


function bool Character.CheckStartJump()
{
	if (!Mario.isControlled())
		return base.Character.CheckStartJump()

	bool wasRolling = (char.flags & char.flag.ROLLING) != 0
	bool wasCrouching = (char.state == char.state.COWERING)
	bool holdingDown = (control.player1.state & CONTROL_DOWN) != 0
	u8 prevMove = mario.move
	s16 groundSpeed = char.groundspeed

	if (!base.Character.CheckStartJump())
		return false

	mario.dive_used = 0
	mario.gp_used = 0
	mario.anim_frame = 0

	if (wasCrouching)
	{
		// Backflip: very high jump backwards
		Mario.addJumpVelocity(Mario.waterScale(0x180))
		char.velocity.x = -Mario.facingSign() * Mario.waterScale(0x1c0)
		Mario.setMove(MARIO_MOVE_BACKFLIP)
		mario.jumpchain = 0
		Mario.playVoice("mario_yahoo")
	}
	else if ((wasRolling && prevMove == MARIO_MOVE_CROUCHSLIDE) || (holdingDown && !wasRolling && abs(groundSpeed) >= 0x200))
	{
		// Long jump: low and far
		s16 speed = clamp(abs(groundSpeed) * 3 / 2, 0x600, 0xa00)
		char.velocity.x = Mario.facingSign() * Mario.waterScale(speed)
		char.velocity.y = Mario.waterScale(-0x480)
		if (global.inv_gravity)
			char.velocity.y = -char.velocity.y
		char.flags &= ~char.flag.CONTROL_LOCK
		Mario.setMove(MARIO_MOVE_LONGJUMP)
		mario.jumpchain = 0
		Mario.playVoice("mario_yahoo")
	}
	else if (wasRolling)
	{
		// Rollout of a belly slide (or any other rolling)
		char.flags &= ~char.flag.CONTROL_LOCK
		Mario.setMove(MARIO_MOVE_ROLLOUT)
		mario.jumpchain = 1
	}
	else if (mario.landtimer > 0 && mario.jumpchain == 2 && abs(groundSpeed) >= 0x400)
	{
		// Triple jump
		Mario.addJumpVelocity(Mario.waterScale(0x200))
		Mario.setMove(MARIO_MOVE_JUMP3)
		mario.jumpchain = 3
		Mario.playVoice("mario_yahoo")
	}
	else if (mario.landtimer > 0 && mario.jumpchain == 1 && abs(groundSpeed) >= 0x100)
	{
		// Double jump
		Mario.addJumpVelocity(Mario.waterScale(0xc0))
		Mario.setMove(MARIO_MOVE_JUMP2)
		mario.jumpchain = 2
		Mario.playVoice("mario_hoo")
	}
	else
	{
		// Single jump
		Mario.setMove(MARIO_MOVE_JUMP1)
		mario.jumpchain = 1
		Mario.playVoice("mario_yah")
	}

	mario.landtimer = 0
	return true
}



//-------------------------------------------------------//
// Air moves                                             //
//-------------------------------------------------------//

// Replaces Sonic's jump moves (insta-shield, drop dash, shield abilities)
function void UpdateSonicJumpMoves()
{
	if (!Mario.isControlled())
	{
		base.UpdateSonicJumpMoves()
		return
	}

	if (char.jumping)
	{
		// Variable jump height, but only for the regular jumps of the triple jump chain
		s16 max_vy = (char.flags & char.flag.UNDERWATER) ? -0x200 : -0x400
		if (char.velocity.y < max_vy && (control.player1.state & CONTROL_ABC) == 0)
		{
			if (mario.move == MARIO_MOVE_JUMP1 || mario.move == MARIO_MOVE_JUMP2 || mario.move == MARIO_MOVE_ROLLOUT)
			{
				char.velocity.y = max_vy
			}
		}
	}
	else
	{
		if (char.spindash == 0)
		{
			char.velocity.y = max(char.velocity.y, -0x0fc0)
		}
	}
}


function void Character.UpdateSonicRollingInAir()
{
	if (Mario.isControlled())
	{
		if (Mario.updateAirActions())
			return
	}
	base.Character.UpdateSonicRollingInAir()
}


// Returns true if the usual in-air update should be skipped this frame
function bool Mario.updateAirActions()
{
	u8 pressed = control.player1.pressed

	if (mario.move == MARIO_MOVE_GP_SPIN)
	{
		// Hang in the air while doing the ground pound flip
		char.velocity.x = 0
		char.velocity.y = 0
		++mario.timer
		if (mario.timer >= MARIO_GP_SPIN_TIME)
		{
			Mario.setMove(MARIO_MOVE_GP_FALL)
			char.velocity.y = global.inv_gravity ? -0x800 : 0x800
		}
		return true
	}

	if (mario.move == MARIO_MOVE_GP_FALL)
	{
		// Straight down, no air control
		char.velocity.x = 0
		if (abs(char.velocity.y) < 0x600 && char.velocity.y >= 0)
			char.velocity.y = 0x600
		return false
	}

	// Wall kick (a dive that hits a wall right after pressing the button counts as a buffered wall kick)
	bool bufferedKick = (mario.move == MARIO_MOVE_DIVE && mario.timer <= 8)
	if (((pressed & CONTROL_ABC) || bufferedKick) && mario.walltimer > 0 && mario.wallside != 0)
	{
		char.velocity.x = -s16(mario.wallside) * Mario.waterScale(0x480)
		char.velocity.y = Mario.waterScale(-0x6c0)
		if (global.inv_gravity)
			char.velocity.y = -char.velocity.y
		if (mario.wallside > 0)
			char.flags |= char.flag.FACING_LEFT
		else
			char.flags &= ~char.flag.FACING_LEFT

		Mario.setRollingInAir()
		char.jumping = 1
		char.double_jump_state = 0
		char.flags &= ~char.flag.CONTROL_LOCK
		Mario.setMove(MARIO_MOVE_WALLKICK)
		mario.anim_frame = 0
		mario.walltimer = 0
		mario.dive_used = 0
		mario.gp_used = 0
		playSound(SFX_JUMP)
		Mario.playVoice("mario_wahoo")
		return false
	}

	// Ground pound
	if ((pressed & CONTROL_DOWN) && mario.gp_used == 0)
	{
		Mario.setRollingInAir()
		char.velocity.x = 0
		char.velocity.y = 0
		char.flags &= ~char.flag.CONTROL_LOCK
		Mario.setMove(MARIO_MOVE_GP_SPIN)
		mario.anim_frame = 0
		mario.gp_used = 1
		mario.dive_used = 1
		playSound(SFX_ROLL)
		return true
	}

	// Dive
	if ((pressed & CONTROL_ABC) && mario.dive_used == 0)
	{
		u8 held = control.player1.state
		if (held & CONTROL_LEFT)
			char.flags |= char.flag.FACING_LEFT
		else if (held & CONTROL_RIGHT)
			char.flags &= ~char.flag.FACING_LEFT

		s16 dir = Mario.facingSign()
		s16 speed = abs(char.velocity.x)
		if ((char.velocity.x < 0) != (dir < 0))
			speed = 0
		speed = clamp(speed + 0x100, 0x500, 0x900)
		char.velocity.x = dir * Mario.waterScale(speed)

		s16 vy = Mario.waterScale(-0x200)
		if (global.inv_gravity)
		{
			char.velocity.y = min(char.velocity.y, -vy)
		}
		else
		{
			char.velocity.y = max(char.velocity.y, vy)
		}

		Mario.setRollingInAir()
		char.flags &= ~char.flag.CONTROL_LOCK
		char.jumping = 0
		Mario.setMove(MARIO_MOVE_DIVE)
		mario.anim_frame = 0
		mario.dive_used = 1
		Mario.playVoice("mario_hoo")
		return false
	}

	return false
}



//-------------------------------------------------------//
// Per-frame update                                      //
//-------------------------------------------------------//

function void Character.UpdateNormalState.Sonic()
{
	if (!Mario.isControlled())
	{
		base.Character.UpdateNormalState.Sonic()
		return
	}

	// Mario never uses Sonic's specials
	sonic.dropdash_counter = 0
	sonic.fastrunanim.timer = 0

	base.Character.UpdateNormalState.Sonic()

	// The base function might have switched A0 back and forth, but it's always the main character here
	Mario.postUpdate()
}


function void Character.UpdateGotHurtState.Sonic()
{
	if (Mario.isControlled())
	{
		if (mario.move != MARIO_MOVE_NONE)
		{
			Mario.setMove(MARIO_MOVE_NONE)
			mario.jumpchain = 0
		}
		if (char.base_state == base_state.HURT && mario.anim_group != 0xfe)
		{
			mario.anim_group = 0xfe
			Mario.playVoice("mario_ooof")
		}
	}
	base.Character.UpdateGotHurtState.Sonic()
}


function void Character.UpdateDiedState.Sonic()
{
	if (Mario.isControlled())
	{
		if (mario.anim_group != 0xff)
		{
			mario.anim_group = 0xff
			Mario.setMove(MARIO_MOVE_NONE)
			Mario.playVoice("mario_mammamia")
		}
	}
	base.Character.UpdateDiedState.Sonic()
}


function void Character.UpdateDrownedState.Sonic()
{
	if (Mario.isControlled())
	{
		if (mario.anim_group != 0xff)
		{
			mario.anim_group = 0xff
			Mario.setMove(MARIO_MOVE_NONE)
			Mario.playVoice("mario_mammamia")
		}
	}
	base.Character.UpdateDrownedState.Sonic()
}


function void Mario.postUpdate()
{
	bool inAir = (char.flags & char.flag.IN_AIR) != 0
	bool rolling = (char.flags & char.flag.ROLLING) != 0

	if (inAir)
	{
		// Wall contact detection for wall kicks
		s16 vx = char.velocity.x
		u8 held = control.player1.state
		if (mario.walltimer > 0)
			--mario.walltimer

		if (vx == 0 && abs(mario.prev_vx) >= 0x100)
		{
			mario.walltimer = MARIO_WALL_WINDOW
			mario.wallside = (mario.prev_vx > 0) ? 1 : -1
		}
		else if (vx == 0 && (held & CONTROL_RIGHT) && (char.hlock_countdown == 0))
		{
			mario.walltimer = MARIO_WALL_WINDOW
			mario.wallside = 1
		}
		else if (vx == 0 && (held & CONTROL_LEFT) && (char.hlock_countdown == 0))
		{
			mario.walltimer = MARIO_WALL_WINDOW
			mario.wallside = -1
		}
		mario.prev_vx = vx
		if (mario.timer < 0xff && mario.move != MARIO_MOVE_GP_SPIN)
			++mario.timer

		// Moves that end if the character is not rolling any more (e.g. after hitting a spring)
		if (!rolling && mario.move != MARIO_MOVE_NONE)
		{
			if (char.state != char.state.ROLLING)
				Mario.setMove(MARIO_MOVE_NONE)
		}
		mario.was_in_air = 1
	}
	else
	{
		mario.walltimer = 0
		mario.prev_vx = 0

		if (mario.was_in_air)
		{
			Mario.onLanding()
			rolling = (char.flags & char.flag.ROLLING) != 0
		}
		mario.was_in_air = 0
		mario.dive_used = 0
		mario.gp_used = 0

		if (mario.landtimer > 0)
		{
			--mario.landtimer
			if (mario.landtimer == 0)
				mario.jumpchain = 0
		}

		if (rolling)
		{
			if (mario.move != MARIO_MOVE_DIVESLIDE)
				Mario.setMove(MARIO_MOVE_CROUCHSLIDE)
		}
		else if (mario.move == MARIO_MOVE_GP_LAND)
		{
			++mario.timer
			if (mario.timer >= 12)
				Mario.setMove(MARIO_MOVE_NONE)
		}
		else if (mario.move != MARIO_MOVE_NONE)
		{
			Mario.setMove(MARIO_MOVE_NONE)
		}
	}

	Mario.updateAnimationTimers()
}


function void Mario.onLanding()
{
	u8 move = mario.move
	if (move == MARIO_MOVE_GP_FALL || move == MARIO_MOVE_GP_SPIN)
	{
		Mario.setMove(MARIO_MOVE_GP_LAND)
		char.groundspeed = 0
		char.velocity.x = 0
		playSound(0x49)
		camera.screenshake.state = 0x10
		mario.jumpchain = 0
	}
	else if (move == MARIO_MOVE_DIVE)
	{
		// Belly slide
		if ((char.flags & char.flag.ROLLING) == 0 && abs(char.groundspeed) >= 0x100)
		{
			char.flags |= char.flag.ROLLING
			char.hitbox_extends.x = char.hitbox.x.ROLLING
			char.hitbox_extends.y = char.hitbox.y.ROLLING
			s8 dy = s8(char.hitbox_extends.y) - s8(char.hitbox.default.y)
			char.position.y.u16 += global.inv_gravity ? dy : -dy
			char.state = char.state.ROLLING
			Mario.setMove(MARIO_MOVE_DIVESLIDE)
		}
		else
		{
			Mario.setMove(MARIO_MOVE_NONE)
		}
		mario.jumpchain = 0
	}
	else if (move == MARIO_MOVE_JUMP1 || move == MARIO_MOVE_ROLLOUT)
	{
		mario.jumpchain = 1
		mario.landtimer = MARIO_CHAIN_WINDOW
		Mario.setMove(MARIO_MOVE_NONE)
	}
	else if (move == MARIO_MOVE_JUMP2)
	{
		mario.jumpchain = 2
		mario.landtimer = MARIO_CHAIN_WINDOW
		Mario.setMove(MARIO_MOVE_NONE)
	}
	else
	{
		mario.jumpchain = 0
		mario.landtimer = 0
		Mario.setMove(MARIO_MOVE_NONE)
	}
}
