//-------------------------------------------------------//
// Mario: sprite rendering                               //
//-------------------------------------------------------//

// Sprites are named "mario_<SM64 animation id>_<index>", rendered from the SM64 animations
// by the mod builder. Extra sprite sets use ids that don't exist in SM64:
constant u8 MARIO_SPRITES_DEATH  = 0xe0
constant u8 MARIO_SPRITES_DROWN  = 0xe1
constant u8 MARIO_SPRITES_BLINK  = 0xe2
constant u8 MARIO_SPRITES_HURT   = 0xe3


function u64 Mario.spriteKey(u8 anim, s32 frame)
{
	u8 count = MarioAnim.SPRITE_COUNT[anim]
	if (count == 0)
	{
		anim = 0xc5
		count = MarioAnim.SPRITE_COUNT[anim]
		frame = 0
	}
	s32 index = frame / s32(max(MarioAnim.SPRITE_STEP[anim], 1))
	index = clamp(index, 0, s32(count) - 1)
	return stringformat("mario_%02x_%d", anim, index)
}


// Sprite of a looping SM64 animation, timed by the frame counter
function u64 Mario.loopingSpriteKey(u8 anim, u8 speedShift)
{
	s32 loopEnd = max(s32(MarioAnim.LOOP_END[anim]), 1)
	return Mario.spriteKey(anim, s32(level.framecounter >> speedShift) % loopEnd)
}


function u64 Mario.getSpriteKey()
{
	u8 st = char.state

	// States set by Sonic 3 itself (death, damage, objects controlling the character)
	if (st == char.state.DIED || st == char.state.DIED_GREY)
		return Mario.spriteKey(MARIO_SPRITES_DEATH, 0)
	if (st == char.state.DROWNED)
		return Mario.spriteKey(MARIO_SPRITES_DROWN, 0)
	if (st == char.state.GOT_HURT || char.base_state == base_state.HURT)
		return Mario.spriteKey(MARIO_SPRITES_HURT, 0)
	if (st == char.state.GOT_HURT_PANIC || st == char.state.FALLING_PANIC)
		return Mario.spriteKey(0x2d, 0)
	if (st == char.state.GRABBED)
		return Mario.loopingSpriteKey(0x58, 1)
	if (st == char.state.LIFTED && Mario.isInWaterCurrent())
		return Mario.loopingSpriteKey(0xac, 0)		// Swept along by the water: flutter kick
	if (st == char.state.TRANSFORMING || st == char.state.LIFTED)
		return Mario.spriteKey(0x94, 0)
	if (st == char.state.WIN_POSE)
	{
		++mario.winTimer
		return Mario.spriteKey(0xcd, min(s32(mario.winTimer >> 1), s32(MarioAnim.LOOP_END[0xcd]) - 1))
	}
	mario.winTimer = 0

	if (st == char.state.HANGING)
		return Mario.loopingSpriteKey(0x35, 1)
	if (st == char.state.HOLDING_ON)
		return Mario.loopingSpriteKey(0x0d, 1)
	if (st == char.state.SONIC_HANGON)
		return Mario.loopingSpriteKey(0x2b, 1)
	if (st == char.state.BREATHE)
		return Mario.spriteKey(0x50, 2)

	// Running around the hollow tree trunk in AIZ 1
	if (Mario.isOnHollowTree())
	{
		u8 direction = ((u16(Mario.getHollowTreePhase()) + 16) >> 5) & 7
		u8 frame = (level.framecounter >> 2) & 3
		return stringformat("mario_tree_%d_%d", direction, frame)
	}

	// Rolling down the mountain at the start of ICZ 1
	if (Mario.isSnowboarding() && st == char.state.ROLLING)
		return Mario.loopingSpriteKey(0x6f, 1)

	// Mario's own animation
	u8 anim = mario.anim
	if ((anim == 0xc3 || anim == 0xc4 || anim == 0xc5) && (level.framecounter & 0x7f) >= 0x7a)
		return Mario.spriteKey(MARIO_SPRITES_BLINK, 0)
	return Mario.spriteKey(anim, Mario.toInt(mario.animFrame))
}


// Sprite rotation: along the ground for running (incl. loops), pitch for swimming and diving
function u8 Mario.getSpriteAngle()
{
	s8 target = 0
	if (Mario.isWaterAction(mario.action) || mario.action == MARIO_ACT_DIVE)
	{
		s8 p = s8(mario.pitch >> 8)
		target = (char.flags & char.flag.FACING_LEFT) ? p : -p
	}
	else if ((char.flags & char.flag.IN_AIR) == 0)
	{
		s8 rot = s8(char.rotation)
		if (abs(rot) > 0x10)
			target = rot
	}

	s8 diff = target - mario.drawAngle
	mario.drawAngle += clamp(diff, -8, 8)
	return u8(mario.drawAngle)
}


// Shows a warning if Mario is drawn, but his movement code doesn't run (then Sonic's code moves him instead).
// That happens when the game uses an older copy of this mod, or with game versions this mod doesn't support.
function void Mario.checkMovementCodeRunning()
{
	if (char.base_state != base_state.NORMAL || (char.control_flags & control_flag.DISABLE_UPDATE))
		return
	if (u16(level.framecounter - mario.updateFrame) <= 4)
		return

	if (mario.missedUpdates < 1000)
		++mario.missedUpdates
	if (mario.missedUpdates < 90)
		return

	Renderer.drawText("oxyfont_regular", 8, 8, "Mario 64 mod v2.2.8:", 0xff4040ff, 1, 0, 0xf000, false, true)
	Renderer.drawText("oxyfont_regular", 8, 18, "Mario's movement code isn't running.", 0xff4040ff, 1, 0, 0xf000, false, true)
	Renderer.drawText("oxyfont_regular", 8, 30, "Another copy of the mod may be active:", 0xffffffff, 1, 0, 0xf000, false, true)
	Renderer.drawText("oxyfont_regular", 8, 40, "in Mods, keep only this version active", 0xffffffff, 1, 0, 0xf000, false, true)
	Renderer.drawText("oxyfont_regular", 8, 50, "and delete older Mario64 copies.", 0xffffffff, 1, 0, 0xf000, false, true)
}


// Replaces the drawing of Sonic with Mario
function bool Standalone.drawCharacterSprite(u8 character, u8 variant, s16 px, s16 py, bool asSmallGhost)
{
	if (!(mario.active && character == CHARACTER_SONIC && variant == 0 && A0 == 0xffffb000))
		return base.Standalone.drawCharacterSprite(character, variant, px, py, asSmallGhost)

	// Sprite 0 means the character is invisible (e.g. inside a CNZ cannon)
	if (char.animation.sprite == 0)
		return base.Standalone.drawCharacterSprite(character, variant, px, py, asSmallGhost)

	u64 key = Mario.getSpriteKey()
	if (!Renderer.hasCustomSprite(key))
		return base.Standalone.drawCharacterSprite(character, variant, px, py, asSmallGhost)

	if (level.vertical_wrap == 0xff00)
	{
		py &= level.height.bitmask
		if (py > move_area.bottom.target * 3/4 && move_area.bottom.target >= 0xe0)
			py -= move_area.bottom.target
	}

	u8 flags = (char.flags & char.flag.FACING_LEFT) ? SPRITE_FLAG_FLIP_X : 0
	if (Mario.isOnHollowTree())
		flags = 0		// The tree sprites cover all directions
	if (global.inv_gravity)
		flags |= SPRITE_FLAG_FLIP_Y
	if (char.sprite_attributes & sprite_attribute.PRIORITY)
		flags |= SPRITE_FLAG_PRIO

	Mario.checkMovementCodeRunning()

	u8 angle = Mario.getSpriteAngle()
	u16 renderQueue = 0xa000 - char.sprite_priority

	if (asSmallGhost)
	{
		Renderer.drawCustomSprite(key, px, py, 0, flags | SPRITE_FLAG_PRIO, 0xa800, angle, 0xc0ffffff, 0x8000)
	}
	else
	{
		Renderer.drawCustomSprite(key, px, py, 0, flags, renderQueue, angle, 255)
	}
	return true
}


// Mario on the snowboard in ICZ 1 (the game draws the snowboarding character as a separate object)
function bool Standalone.onWriteToSpriteTable(s16 px, s16 py, u16 renderQueue)
{
	if (mario.active && objA0.mapping_offset == 0x347e30)
	{
		u64 key = stringformat("mario_sb_%02x", objA0.animation.sprite)
		if (Renderer.hasCustomSprite(key))
		{
			u8 flags = (objA0.sprite_attributes & sprite_attribute.PRIORITY) ? SPRITE_FLAG_PRIO : 0
			if (objA0.render_flags & render_flag.FLIP_X)
				flags |= SPRITE_FLAG_FLIP_X
			Renderer.drawCustomSprite(key, px, py, 0x00, flags, renderQueue)
			return true
		}
	}
	return base.Standalone.onWriteToSpriteTable(px, py, renderQueue)
}


// Other places that ask for the character sprite (should not happen for Mario, but just in case)
function u64 Standalone.getModdedAnimationSpriteKey(u8 character, u16 animationSpriteEx)
{
	if (mario.active && character == CHARACTER_SONIC && A0 == 0xffffb000 && char.animation.sprite != 0)
	{
		u64 key = Mario.getSpriteKey()
		if (Renderer.hasCustomSprite(key))
			return key
	}
	return base.Standalone.getModdedAnimationSpriteKey(character, animationSpriteEx)
}



//-------------------------------------------------------//
// HUD & results                                         //
//-------------------------------------------------------//

function string getCharacterLivesIcon(u8 character)
{
	if (mario.active && character == CHARACTER_SONIC)
		return "hud_lives_icon_mario"
	return base.getCharacterLivesIcon(character)
}

function string getCharacterResultsNameplate(u8 character)
{
	if (mario.active && character == CHARACTER_SONIC)
		return "result_nameplate_mario"
	return base.getCharacterResultsNameplate(character)
}
